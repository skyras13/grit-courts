# ─────────────────────────────────────────────────────────────────────────────
# GRIT Courts — environment variables
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* are exposed to the browser;
# everything else is server-only. NEVER put the service-role key in a NEXT_PUBLIC_*.
# The app runs in "demo mode" with friendly fallbacks when keys are absent, so you
# can show the site before wiring real services. See docs/03-architecture.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, OG, CAPI)
NEXT_PUBLIC_SITE_URL=http://localhost:3400

# ── Supabase (Postgres + Storage + RLS) ─────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — full DB access, never ship to client

# ── AI render provider (pick ONE; Replicate is the locked default) ──────────
RENDER_PROVIDER=replicate         # replicate | fal | mock
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-dev
FAL_KEY=

# ── Email (owner + homeowner notifications) ─────────────────────────────────
RESEND_API_KEY=
OWNER_EMAIL=owner@builtwithgrit.com
FROM_EMAIL=leads@builtwithgrit.com

# ── Speed-to-lead automation ────────────────────────────────────────────────
LEAD_WEBHOOK_URL=                 # Make / Zapier / GoHighLevel inbound webhook
TWILIO_ACCOUNT_SID=               # optional
TWILIO_AUTH_TOKEN=                # optional
TWILIO_FROM_NUMBER=               # optional

# ── Attribution / analytics ─────────────────────────────────────────────────
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=             # optional — for Meta Events Manager test events
NEXT_PUBLIC_GA_ID=

# ── Admin dashboard (lightweight v1 gate; Clerk deferred) ───────────────────
ADMIN_PASSWORD=change-me-please
ADMIN_SESSION_SECRET=use-a-long-random-string
